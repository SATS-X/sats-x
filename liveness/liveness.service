[Unit]
Description=Liveness Detection (uvicorn)
After=network.target

[Service]
User=root
Group=root
WorkingDirectory=/projects/liveness-detection/app

# dùng virtualenv của bạn
Environment="PATH=/projects/liveness-detection/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PYTHONUNBUFFERED=1"

# BIND PUBLIC: 0.0.0.0 để truy cập bằng IP public:8000
ExecStart=/projects/liveness-detection/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 1 --log-level info

Restart=always
RestartSec=5
LimitNOFILE=65536
StartLimitBurst=5
StartLimitIntervalSec=60

[Install]
WantedBy=multi-user.target