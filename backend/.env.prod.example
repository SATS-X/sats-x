# Dùng với docker-compose.prod.yml trên EC2. Copy thành .env rồi điền giá trị thật —
# KHÔNG commit file .env đã điền lên git.
#
#   cp .env.prod.example .env
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"   # x2 cho 2 JWT secret
#   docker compose -f docker-compose.prod.yml up -d --build

# Mật khẩu Postgres nội bộ (không lộ ra ngoài, chỉ container app đọc được)
DB_PASSWORD=

# Tên miền HTTPS của hệ thống, lấy từ `terraform output -raw backend_site_address`
SITE_ADDRESS=

# Domain frontend thật sẽ gọi vào API này, phân tách bằng dấu phẩy
CORS_ORIGINS=https://your-site-address

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Token dùng chung với Lambda (biến backend_service_token trong Terraform) —
# xác thực request từ thiết bị IoT, KHÔNG phải JWT giáo viên. Sinh bằng lệnh
# trên rồi dán GIỐNG HỆT vào cả đây và `terraform apply -var="backend_service_token=..."`.
SERVICE_TOKEN=

# Ký vé kết nối WebSocket của console (tối thiểu 32 ký tự). Phải GIỐNG HỆT biến
# ws_ticket_secret bên Terraform, nếu không console sẽ không kết nối được.
WS_TICKET_SECRET=
