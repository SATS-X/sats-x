# API & Backend Configuration
VITE_API_BASE_URL=http://localhost:4000

# AWS WebSocket API Gateway (`terraform output websocket_url`). Để trống thì chạy
# hoàn toàn cục bộ: khuôn mặt nhận diện bằng OpenCV ngay trên máy này, dùng được
# cho triển lãm mà không cần tài khoản AWS. Có URL thì dùng Rekognition qua AWS.
VITE_WS_URL=
# Tuỳ chọn: local | aws. Mặc định: aws nếu có VITE_WS_URL, ngược lại local.
# VITE_FACE_PROVIDER=local

# AWS S3 Storage — chỉ để build đường dẫn ảnh public, KHÔNG phải credentials.
# Frontend không bao giờ được giữ AWS access key/secret key: Vite build thẳng mọi
# biến VITE_* vào bundle JS, ai mở DevTools cũng đọc được. Toàn bộ thao tác cần
# quyền ghi S3 (upload, presigned URL) phải đi qua Lambda dùng IAM role.
VITE_AWS_REGION=ap-southeast-1
VITE_AWS_S3_BUCKET=attendance-system-dev-022499043310
